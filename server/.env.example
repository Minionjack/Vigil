# server/ itself is orphaned (nothing live imports it — see README.md),
# but this file is still where every script/CLI/edge-deploy in this repo
# reads its credentials from (proactive/, scripts/, the supabase CLI
# invocations in this README's own instructions). Real values come from
# the Supabase dashboard (Project Settings > API, and your own personal
# access token under Account > Access Tokens) once you have organization
# access — never commit real values here.

# Anthropic — used directly by proactive/'s local message generation.
ANTHROPIC_API_KEY=

# Supabase project — Project Settings > API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI auth — Account > Access Tokens. Needed for `supabase
# functions deploy`/`supabase db push` (see README.md).
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# The single dev-account's auth credentials (this project is single-user
# today — see BRIEF-PHASE2.md), and that account's user_id, needed by
# proactive/'s CLI (`npm run log`, `check.ts`) to know whose events to
# read/write.
SUPABASE_AUTH_EMAIL=
SUPABASE_AUTH_PASSWORD=
PROACTIVE_USER_ID=

# Expo — Account Settings > Access Tokens (expo.dev). Needed to publish
# an EAS Update (see README.md's "Publishing an update").
EXPO_TOKEN=

PORT=3000
